# Personal aliases. These load after oh-my-zsh, so they win over its defaults.

alias clr="clear"
alias rmd="rm -rf"
alias glog1="g log --oneline"

# Skill Nation USA website: runs on port 3002 to avoid clashing with 3000/3001.
alias snusa-dev="PORT=3002 pnpm dev"
alias snusa-start="PORT=3002 pnpm start"
